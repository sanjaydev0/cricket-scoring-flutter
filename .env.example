# Live rooms (optional). Copy to .env, or pass these directly as
# --dart-define values at build time. Never commit the real values.
#
#   flutter build apk --release \
#     --dart-define=SUPABASE_URL=https://abcdefgh.supabase.co \
#     --dart-define=SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Supabase dashboard -> Settings -> API.
# Use the publishable key (or the legacy anon key).
# NEVER the service_role key: it bypasses row level security.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=